{
  "name": "@opentype/mcp",
  "version": "0.1.0",
  "description": "MCP server for OpenType: calibrated decisions, validated verdicts and model routing for coding agents.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OpentypeAI/opentype-js/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpentypeAI/opentype-js.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/OpentypeAI/opentype-js/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "opentype-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@opentype/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
